{
  "name": "grayzone-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "GRAYZONE PROTOCOL - Mobile PvE Extraction Shooter Prototype (technical feasibility study)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build-icons.mjs && vite build",
    "preview": "vite preview --host",
    "viewports": "node tests/viewports.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts",
    "icons": "node scripts/build-icons.mjs",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
